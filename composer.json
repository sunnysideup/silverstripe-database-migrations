{
    "name": "sunnysideup/database-migrations",
    "description": "Add an Atomic Migration interface to any BuildTask and it will automatically run them on dev/build and record that they have run in the database.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "atomic",
        "upgrade",
        "migrate",
        "convert",
        "database migration",
        "dev tool",
        "reliable",
        "up and downgrade"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^5.0",
        "silverstripe/admin": "^2.0"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "Sunnysideup\\DatabaseMigrations\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Nicolaas Thiemen Francken",
            "email": "modules@sunnysideup.co.nz",
            "role": "lead developer"
        }
    ]
}